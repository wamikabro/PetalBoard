[Unit]
Description=PetalBoard API (FastAPI)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=petalboard
Group=petalboard
WorkingDirectory=/opt/petalboard/api
EnvironmentFile=/etc/petalboard.env
ExecStart=/opt/petalboard/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=3
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
