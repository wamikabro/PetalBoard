---
import App from '../layouts/App.astro';
---
<App title="Log in" bare>
  <div class="min-h-[100dvh] flex flex-col items-center justify-center px-5 py-10"
       style="background: radial-gradient(120% 80% at 50% 0%, rgb(var(--brand) / .18), transparent 60%), rgb(var(--surface));">
    <form id="login" class="w-full max-w-[360px]">
      <div class="flex flex-col items-center text-center mb-7">
        <img src="/favicon.svg" alt="" class="w-16 h-16 rounded-2xl shadow-lg shadow-brand/20" />
        <h1 class="mt-4 text-2xl font-semibold tracking-tight">PetalBoard</h1>
        <p class="mt-1 text-sm text-muted">Enter your password to continue</p>
      </div>

      <div class="card p-5 shadow-xl shadow-black/5 space-y-4">
        <div>
          <label class="sr-only" for="password">Password</label>
          <div class="relative">
            <input class="input !h-12 !text-lg !pr-12 tracking-wide" id="password" name="password" type="password"
                   placeholder="Password" autocomplete="current-password" autocapitalize="none" autocorrect="off"
                   spellcheck="false" enterkeyhint="go" required autofocus />
            <button type="button" id="show" class="absolute inset-y-0 right-0 w-12 grid place-items-center text-muted hover:text-ink" aria-label="Show password">
              <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M12 5c-5 0-9 4.5-10 7 1 2.5 5 7 10 7s9-4.5 10-7c-1-2.5-5-7-10-7zm0 11.5A4.5 4.5 0 1 1 12 7.5a4.5 4.5 0 0 1 0 9zm0-7a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z" /></svg>
            </button>
          </div>
        </div>
        <p id="err" class="text-sm text-bad hidden" role="alert"></p>
        <button class="btn-primary w-full !h-12 !text-base" type="submit">Log in</button>
      </div>

      <p class="mt-5 text-center text-xs text-muted">This device stays logged in after the first time.</p>
      <a id="open-copy" href="/" class="hidden mt-4 btn-ghost w-full !h-11 justify-center">Open the data on this device without logging in</a>
    </form>
  </div>
</App>

<script>
  import { api, hasDeviceCopy, saveLogin } from '../lib/api';
  // Logged out, but the shop's data is kept on this device: it can be opened (read only) without logging in.
  if (hasDeviceCopy()) {
    const a = document.getElementById('open-copy') as HTMLAnchorElement;
    const next = new URLSearchParams(location.search).get('next');
    if (next && next.startsWith('/') && !next.startsWith('//')) a.href = next;
    a.classList.remove('hidden');
  }
  const form = document.getElementById('login') as HTMLFormElement;
  const err = document.getElementById('err')!;
  const pw = document.getElementById('password') as HTMLInputElement;
  document.getElementById('show')!.addEventListener('click', () => {
    pw.type = pw.type === 'password' ? 'text' : 'password';
    pw.focus();
  });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    btn.disabled = true;
    btn.textContent = 'Logging in…';
    err.classList.add('hidden');
    if (!navigator.onLine) {
      err.textContent = hasDeviceCopy()
        ? 'No internet: logging in needs a connection. You can still open the data on this device below.'
        : 'No internet: logging in needs a connection.';
      err.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Log in';
      return;
    }
    try {
      const r = await api('/auth/login', { method: 'POST', body: { password: pw.value } });
      saveLogin(r.token, r.user);
      const next = new URLSearchParams(location.search).get('next');
      location.href = next && next.startsWith('/') && !next.startsWith('//') ? next : '/';
    } catch (ex: any) {
      err.textContent = ex.message;
      err.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Log in';
      pw.select();
    }
  });
</script>
