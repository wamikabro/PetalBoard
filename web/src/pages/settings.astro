---
import App from '../layouts/App.astro';
---
<App title="Settings" active="settings">
  <div class="space-y-5">
    <div><p class="text-sm text-muted">Settings</p><h1 class="h-title">Shop, people and backups</h1></div>

    <section class="card card-pad space-y-3">
      <div>
        <h2 class="font-semibold">Backup and downloads</h2>
        <p class="text-sm text-muted">A backup is a folder of Excel files you can open and read: a summary of every supplier, one file per month with every bill laid out like the paper, one file per supplier and per investor, and every day in one list. It takes up to a minute to prepare. Keep one copy off this computer.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button class="btn-primary" id="backup">Download full backup (.zip)</button>
        <a class="btn-ghost" href="/suppliers">One supplier's data →</a>
        <a class="btn-ghost" href="/investors">One investor's data →</a>
        <a class="btn-ghost" href="/reports">Any date range (CSV / PDF) →</a>
      </div>
      <p class="text-xs text-muted" id="backup-note"></p>
    </section>

    <section class="card card-pad space-y-3" id="device-card">
      <div>
        <h2 class="font-semibold">Data on this device</h2>
        <p class="text-sm text-muted">This phone or computer keeps its own copy of all the data and updates it every few minutes.
          If the server is ever lost, the data is still here. A problem on the server never deletes this copy.</p>
      </div>
      <div id="device-status" class="text-sm">…</div>
      <div id="device-warning" class="hidden rounded-lg bg-warn/10 text-sm p-3 space-y-2"></div>
      <div class="flex flex-wrap gap-2">
        <button class="btn-ghost" id="device-sync">Update now</button>
        <button class="btn-ghost" id="device-copy">Download this device's copy (.json)</button>
      </div>
    </section>

    <section class="card card-pad space-y-3" id="sync">
      <div>
        <h2 class="font-semibold">Changes made on this device</h2>
        <p class="text-sm text-muted">Daily entries and kharcha typed with no connection wait here and are sent by themselves when the connection is back (open the app to send them on iPhone).
          If two phones changed the same day, the change made later is kept and the other is listed below to check.</p>
      </div>
      <div id="outbox-status" class="text-sm"></div>
      <div class="flex flex-wrap gap-2"><button class="btn-ghost" id="outbox-send">Send now</button></div>
      <div id="problems"></div>
    </section>

    <section class="card card-pad space-y-3 hidden" id="restore-card">
      <div>
        <h2 class="font-semibold">Restore a new server</h2>
        <p class="text-sm text-muted">Only for a <b>new, empty</b> server, after the old one was lost. Pick a device's copy (.json from "Download this device's copy") or a full backup (.zip). A server that already has bills or suppliers refuses it, so nothing is ever overwritten. Logins are not in the copy: people need new logins on the new server.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <input type="file" id="restore-file" accept=".json,.zip,application/json,application/zip" class="text-sm" />
        <button class="btn-ghost" id="restore-go" disabled>Restore</button>
      </div>
      <div id="restore-info" class="text-sm text-muted"></div>
    </section>

    <section class="card card-pad">
      <div class="flex items-center justify-between gap-2">
        <div><h2 class="font-semibold">Shop details</h2><p class="text-sm text-muted">Bills are printed on the shop's own form (<code>web/public/bill/empty-bill.jpg</code>). To change the names or phone numbers on the bill, replace that image with a new blank form of the same size and layout.</p></div>
        <a href="/bills" class="text-sm text-brand">See a bill →</a>
      </div>
      <form id="shop" class="mt-4 grid sm:grid-cols-2 gap-3"></form>
    </section>

    <section class="card card-pad">
      <div class="flex items-center justify-between gap-2">
        <div><h2 class="font-semibold">Flowers</h2><p class="text-sm text-muted">Kinds of flower bought</p></div>
        <button class="btn-ghost" id="add-flower">+ Flower</button>
      </div>
      <div id="flowers" class="mt-3 flex flex-wrap gap-2"></div>
    </section>

    <section class="card overflow-hidden" id="users-card">
      <div class="card-pad pb-2 flex items-center justify-between gap-2">
        <div><h2 class="font-semibold">People who can log in</h2>
          <p class="text-sm text-muted">Each person logs in with their own password only. Owner: everything. Manager: close months, advances, investors. Clerk: daily entry. Viewer: look only.</p></div>
        <button class="btn-ghost" id="add-user">+ Person</button>
      </div>
      <div class="overflow-x-auto"><table class="tbl"><thead><tr><th>Name</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody id="users"></tbody></table></div>
    </section>

    <section class="card card-pad">
      <h2 class="font-semibold">Appearance</h2>
      <div class="mt-2 flex gap-2" id="theme">
        <button class="btn-ghost" data-t="light">Light</button><button class="btn-ghost" data-t="dark">Dark</button><button class="btn-ghost" data-t="">Same as phone / computer</button>
      </div>
    </section>
  </div>
</App>

<script>
  import { api, API_URL, can, getToken, getUser } from '../lib/api';
  import { save } from '../lib/outbox';
  import { esc } from '../lib/format';
  import { busy, dialog, download, toast } from '../lib/ui';
  import { deviceCopy, getState, outboxItems, problemDelete, problemsAll, syncNow, type SyncState } from '../lib/offline';
  import { flush, outboxStatus } from '../lib/outbox';

  // ---- changes made on this device: waiting, and problems to check ----
  const fmtTime = (t: number) => new Date(t).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
  const dayVals = (v: any) => (v ? `${v.weight ?? '—'} kg × ${v.rate ?? '—'}` : 'empty');
  function problemText(p: any): string {
    if (p.what === 'kept_newer') return `Not saved: ${esc(p.theirs?.by || 'someone')} changed this day later (${fmtTime(Date.parse(p.theirs?.at))}) to ${dayVals(p.theirs)}. This device had ${dayVals(p.yours)}.`;
    if (p.what === 'replaced') return `Saved ${dayVals(p.yours)}, replacing ${dayVals(p.theirs)} entered by ${esc(p.theirs?.by || 'someone')}.`;
    return `Not saved: ${esc(p.message || 'the server refused it')}`;
  }
  async function showOutbox() {
    const waiting = (await outboxItems()).filter((w: any) => !w.sent), problems = await problemsAll();
    document.getElementById('outbox-status')!.innerHTML = waiting.length
      ? `<p class="text-warn font-medium">${waiting.length} change${waiting.length > 1 ? 's' : ''} waiting to be sent</p>
         <ul class="mt-1 text-muted list-disc pl-5">${waiting.slice(0, 20).map((w: any) => `<li>${esc(w.label || w.kind)}</li>`).join('')}</ul>`
      : '<p class="text-muted">Nothing waiting: every change made here has reached the server.</p>';
    document.getElementById('problems')!.innerHTML = problems.length ? `
      <h3 class="font-semibold text-bad">Sync problems to check (${problems.length})</h3>
      <ul class="mt-2 divide-y divide-line">${problems.sort((a: any, b: any) => b.at - a.at).map((p: any) => `
        <li class="py-2 flex items-start gap-3">
          <div class="flex-1 min-w-0 text-sm"><p class="font-medium">${esc(p.label || '')}</p><p class="text-muted">${problemText(p)}</p>
            <p class="text-xs text-faint">${fmtTime(p.at)}${p.date && p.supplier_id ? ` · <a class="text-brand" href="/daily?date=${p.date}">open that day</a>` : ''}</p></div>
          <button class="btn-ghost !py-1 text-xs" data-problem="${p.id}">Checked</button>
        </li>`).join('')}</ul>` : '';
  }
  showOutbox();
  window.addEventListener('petalboard:outbox', () => showOutbox());
  document.getElementById('sync')!.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    if (b.id === 'outbox-send') await busy(b, async () => { const st = await flush(); toast(st.waiting ? 'No connection: still waiting' : 'All sent', st.waiting ? 'error' : 'ok'); });
    if (b.dataset.problem) { await problemDelete(Number(b.dataset.problem)); outboxStatus(); }
  });

  // ---- data on this device ----
  function showDevice(st: SyncState) {
    const when = (t?: number) => (t ? new Date(t).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'never');
    const c = st.counts || {};
    const label: Record<string, string> = { ok: 'Up to date', offline: 'Could not reach the server', blocked: 'Update stopped', error: 'Problem', never: 'Not saved yet' };
    document.getElementById('device-status')!.innerHTML = `
      <p><span class="chip ${st.status === 'ok' ? 'bg-good/10 text-good' : st.status === 'never' ? 'bg-sunken text-muted' : 'bg-warn/10 text-warn'}">${label[st.status] || st.status}</span>
        <span class="text-muted ml-1">Last updated ${when(st.lastSync)}</span></p>
      <p class="text-muted mt-1 tabular-nums">${(c.suppliers || 0).toLocaleString()} suppliers · ${(c.bills || 0).toLocaleString()} bills ·
        ${(c.bill_days || 0).toLocaleString()} days · ${(c.kharcha || 0).toLocaleString()} kharcha · ${(c.advances || 0).toLocaleString()} advance entries</p>`;
    const w = document.getElementById('device-warning')!;
    w.classList.toggle('hidden', !st.warning);
    if (st.warning) {
      w.innerHTML = `<p class="text-warn font-medium">${esc(st.warning)}</p>
        <p class="text-muted">Keep this device's copy until someone checks the server. Download it below to be safe.</p>
        ${st.status === 'blocked' && can('owner') ? '<button class="btn-ghost !py-1.5 text-sm" id="device-accept">The server is right: replace this copy</button>' : ''}`;
    }
  }
  getState().then(showDevice);
  window.addEventListener('petalboard:sync', (e) => showDevice((e as CustomEvent).detail));
  document.getElementById('device-card')!.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    if (b.id === 'device-sync') await busy(b, async () => { const st = await syncNow({ force: true }); toast(st.status === 'ok' ? 'Up to date' : 'Not updated: ' + (st.warning || 'no connection'), st.status === 'ok' ? 'ok' : 'error'); });
    if (b.id === 'device-copy') {
      const blob = await deviceCopy();
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `petalboard-device-copy-${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 5000);
    }
    if (b.id === 'device-accept') {
      const ok = await dialog('Replace the copy on this device?', '<p class="text-sm">The copy on this device will be replaced by what the server has now. Download the copy on this device first if you are not sure.</p>', 'Replace', true);
      if (ok) await busy(b, async () => { const st = await syncNow({ accept: true }); toast(st.status === 'ok' ? 'Replaced' : 'Not updated', st.status === 'ok' ? 'ok' : 'error'); });
    }
  });

  const $ = (id: string) => document.getElementById(id)!;
  const FIELDS: [string, string, boolean][] = [
    ['name_ur', 'Shop name (Urdu)', true], ['name_en', 'Shop name (English)', false], ['tagline_ur', 'Line under the name (Urdu)', true],
    ['address_ur', 'Address (Urdu)', true], ['proprietor_label_ur', 'Label (Urdu)', true], ['default_commission_pct', 'Commission % for new suppliers', false],
    ['proprietor1_name_ur', 'First owner (Urdu)', true], ['proprietor1_phone', 'First owner phone', false],
    ['proprietor2_name_ur', 'Second owner (Urdu)', true], ['proprietor2_phone', 'Second owner phone', false],
  ];

  async function loadShop() {
    const s = await api('/settings');
    const editable = can('owner');
    $('shop').innerHTML = FIELDS.map(([k, label, ur]) => `
      <div class="${k === 'tagline_ur' ? 'sm:col-span-2' : ''}"><label class="label" for="f-${k}">${label}</label>
      <input id="f-${k}" name="${k}" class="input ${ur ? 'urdu !leading-loose' : ''}" ${ur ? 'dir="rtl"' : ''} value="${esc(s[k])}" ${editable ? '' : 'disabled'} /></div>`).join('')
      + (editable ? '<div class="sm:col-span-2"><button class="btn-primary">Save</button></div>' : '');
  }
  $('shop').addEventListener('submit', async (e) => {
    e.preventDefault();
    const body: any = Object.fromEntries(new FormData(e.target as HTMLFormElement).entries());
    body.default_commission_pct = Number(body.default_commission_pct);
    await busy((e.target as HTMLFormElement).querySelector('button'), async () => { const r = await save('PATCH', '/settings', body, 'Shop details'); if (!r.queued) toast('Saved'); });
  });

  async function loadFlowers() {
    const fl = await api('/flowers');
    $('flowers').innerHTML = fl.map((f: any) => `<button class="chip !text-sm !px-3 !py-1 ${f.active ? 'bg-brand-soft text-brand' : 'bg-sunken text-muted line-through'}" data-flower="${f.id}" data-name="${esc(f.name)}" data-ur="${esc(f.name_ur || '')}" data-active="${f.active}">${esc(f.name)} ${f.name_ur ? `<span class="urdu">${esc(f.name_ur)}</span>` : ''}</button>`).join('');
  }
  $('flowers').addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-flower]');
    if (!b || !can('manager')) return;
    const v = await dialog('Flower', `
      <div><label class="label">Name</label><input name="name" class="input" value="${b.dataset.name}" /></div>
      <div><label class="label">Urdu name</label><input name="name_ur" class="input urdu" dir="rtl" value="${b.dataset.ur}" /></div>
      <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="active" value="1" ${b.dataset.active === 'true' ? 'checked' : ''} /> In use</label>`);
    if (v) await busy(b, async () => { await save('PATCH', `/flowers/${b.dataset.flower}`, { name: v.name, name_ur: v.name_ur || null, active: !!v.active }, `Flower ${v.name}`); loadFlowers(); });
  });
  $('add-flower').addEventListener('click', async () => {
    const v = await dialog('New flower', `<div><label class="label">Name</label><input name="name" class="input" required /></div>
      <div><label class="label">Urdu name</label><input name="name_ur" class="input urdu" dir="rtl" /></div>`, 'Add');
    if (v) try { await save('POST', '/flowers', { name: v.name, name_ur: v.name_ur || null }, `New flower ${v.name}`); loadFlowers(); } catch (ex: any) { toast(ex.message, 'error'); }
  });

  const ROLES = ['owner', 'manager', 'clerk', 'viewer'];
  async function loadUsers() {
    const us = await api('/users');
    const me = getUser();
    $('users').innerHTML = us.map((u: any) => `<tr>
      <td class="font-medium">${esc(u.display_name)}${u.id === me?.id ? ' <span class="text-xs text-muted">(you)</span>' : ''}</td>
      <td class="capitalize">${u.role}</td><td>${u.active ? '<span class="chip bg-good/10 text-good">Active</span>' : '<span class="chip bg-sunken text-muted">Off</span>'}</td>
      <td class="text-right"><button class="text-sm text-brand" data-user="${u.id}">Edit</button></td></tr>`).join('');
    (window as any)._users = us;
  }
  $('users').addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-user]');
    if (!b) return;
    const u = (window as any)._users.find((x: any) => String(x.id) === b.dataset.user);
    const v = await dialog(`Edit ${u.display_name}`, `
      <div><label class="label">Name</label><input name="display_name" class="input" value="${esc(u.display_name)}" /></div>
      <div><label class="label">Role</label><select name="role" class="input">${ROLES.map((r) => `<option ${r === u.role ? 'selected' : ''}>${r}</option>`).join('')}</select></div>
      <div><label class="label">New password (leave empty to keep; it logs them out everywhere)</label><input name="password" class="input" minlength="8" autocomplete="off" /></div>
      <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="active" value="1" ${u.active ? 'checked' : ''} /> Can log in</label>`);
    if (v) await busy(b, async () => {
      await api(`/users/${u.id}`, { method: 'PATCH', body: { display_name: v.display_name, role: v.role, active: !!v.active, password: v.password || undefined } });
      toast('Saved'); loadUsers();
    });
  });
  $('add-user').addEventListener('click', async () => {
    const v = await dialog('New person', `
      <div><label class="label">Name</label><input name="display_name" class="input" required /></div>
      <div><label class="label">Role</label><select name="role" class="input">${ROLES.map((r) => `<option ${r === 'clerk' ? 'selected' : ''}>${r}</option>`).join('')}</select></div>
      <div><label class="label">Password (at least 8 letters, different from everyone else's: it is how they log in)</label><input name="password" class="input" minlength="8" required autocomplete="off" /></div>`, 'Add');
    if (v) try { await api('/users', { method: 'POST', body: v }); toast('Added'); loadUsers(); } catch (ex: any) { toast(ex.message, 'error'); }
  });

  document.querySelectorAll<HTMLButtonElement>('#theme button').forEach((b) => b.addEventListener('click', () => {
    const t = b.dataset.t!;
    try { t ? localStorage.setItem('petalboard_theme', t) : localStorage.removeItem('petalboard_theme'); } catch {}
    if (t) document.documentElement.dataset.theme = t; else delete document.documentElement.dataset.theme;
    window.dispatchEvent(new Event('themechange'));
  }));


  // ---- restore a new, empty server from a copy ----
  const NAMES: Record<string, string> = { suppliers: 'suppliers', bills: 'bills', bill_days: 'days', kharcha: 'kharcha', advances: 'advance entries', investors: 'investors' };
  function countsText(c: Record<string, number>) {
    return Object.keys(NAMES).filter((k) => k in c).map((k) => `${(c[k] || 0).toLocaleString()} ${NAMES[k]}`).join(' · ');
  }
  async function readRestoreFile(f: File): Promise<string> {
    if (/\.zip$/i.test(f.name)) return `Backup zip, ${(f.size / 1048576).toFixed(1)} MB.`;
    let data: any;
    try { data = JSON.parse(await f.text()); } catch { throw new Error('This file is not a PetalBoard copy.'); }
    if (!data || !Array.isArray(data.bills) || !Array.isArray(data.suppliers)) throw new Error('This file has no bills or suppliers.');
    const c: Record<string, number> = {};
    for (const k of Object.keys(NAMES)) if (Array.isArray(data[k])) c[k] = data[k].length;
    const months = data.bills.map((b: any) => String(b.month || '').slice(0, 7)).filter(Boolean).sort();
    return `${countsText(c)}${months.length ? ` · ${months[0]} to ${months[months.length - 1]}` : ''}`;
  }
  if (can('owner')) {
    $('restore-card').classList.remove('hidden');
    const input = $('restore-file') as HTMLInputElement;
    const go = $('restore-go') as HTMLButtonElement;
    input.addEventListener('change', async () => {
      const f = input.files?.[0];
      go.disabled = true;
      $('restore-info').textContent = '';
      if (!f) return;
      try {
        $('restore-info').textContent = 'In this file: ' + (await readRestoreFile(f));
        go.disabled = false;
      } catch (ex: any) { $('restore-info').innerHTML = `<span class="text-bad">${esc(ex.message)}</span>`; }
    });
    go.addEventListener('click', async () => {
      const f = input.files?.[0];
      if (!f) return;
      const ok = await dialog('Load this copy into the server?', `<p class="text-sm">${esc(f.name)} will be loaded into the server at <b>${esc(API_URL)}</b>. This only works if that server is new and empty.</p>`, 'Restore');
      if (!ok) return;
      await busy(go, async () => {
        try {
          const res = await fetch(API_URL + '/restore', { method: 'POST', headers: { Authorization: `Bearer ${getToken()}`, 'Content-Type': 'application/octet-stream' }, body: f });
          const data = await res.json().catch(() => null);
          if (!res.ok) throw new Error(typeof data?.detail === 'string' ? data.detail : `Error ${res.status}`);
          $('restore-info').innerHTML = `<span class="text-good">Restored: ${esc(countsText(data.restored || {}))}.</span> Devices that used the old server will say "Update stopped" (a different server): check a few bills here, then tap "The server is right" on each of them.`;
          toast('Restored');
          syncNow().catch(() => {});
        } catch (ex: any) {
          $('restore-info').innerHTML = `<span class="text-bad">${esc(ex.message === 'Failed to fetch' ? 'Cannot reach the server.' : ex.message)}</span>`;
        }
      });
    });
  }

  if (can('owner')) {
    $('backup').addEventListener('click', (e) => download('/export/backup', e.currentTarget as HTMLButtonElement));
    loadUsers();
  } else {
    ($('backup') as HTMLButtonElement).disabled = true;
    $('backup-note').textContent = 'Only the owner can download a full backup.';
    $('users-card').classList.add('hidden');
  }
  if (!can('manager')) $('add-flower').classList.add('hidden');
  loadShop();
  loadFlowers();
</script>
