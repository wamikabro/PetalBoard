---
import App from '../layouts/App.astro';
---
<App title="Bill" active="bills" wide>
  <div id="page" class="space-y-4">
    <p class="text-muted text-sm">Loading…</p>
  </div>
</App>

<script>
  import { api, can } from '../lib/api';
  import { billSheetHtml, type Bill, type Settings } from '../lib/billsheet';
  import { balanceWords, esc, kg, monthName, num, rs, rsSigned } from '../lib/format';
  import { busy, dialog, qp, setQuery, toast } from '../lib/ui';

  const id = Number(qp('id'));
  let tab = (qp('tab') as 'paper' | 'edit') || 'paper';
  let bill: Bill;
  let settings: Settings;
  let nb: { prev: number | null; next: number | null; position: number; count: number };
  const page = document.getElementById('page')!;

  const amountOf = (w: number | null, r: number | null) =>
    w == null || r == null ? null : Math.floor((Math.round(w * 1000) * Math.round(r * 100)) / 100000);

  function summary() {
    const t = bill.totals;
    const line = (label: string, value: string, cls = '') =>
      `<div class="flex justify-between gap-3 py-1.5 ${cls}"><dt class="text-muted">${label}</dt><dd class="tabular-nums font-medium">${value}</dd></div>`;
    const st = bill.settlement;
    return `
    <div class="card card-pad space-y-4">
      <div>
        <p class="stat-label">${t.final >= 0 ? 'Final total' : 'Final total'}</p>
        <p class="text-3xl font-semibold tabular-nums ${t.final < 0 ? 'neg' : t.final > 0 ? 'pos' : ''}">${rsSigned(t.final)}</p>
        <p class="text-sm text-muted">${balanceWords(t.final)}</p>
      </div>
      <dl class="text-sm divide-y divide-line">
        ${line('Flowers', `${kg(t.weight)} kg · ${t.days_supplied} days`)}
        ${line('Average rate', t.avg_rate ? `Rs ${t.avg_rate}/kg` : '—')}
        ${line('Total amount', rs(t.total))}
        ${line(`Commission (${bill.commission_pct}%)`, '− ' + rs(t.commission))}
        ${line('Net amount', rs(t.net))}
        ${line('Kharcha', '− ' + rs(t.kharcha))}
        ${t.opening_due ? line(t.opening_due > 0 ? 'Owed from last month' : 'Due from last month', (t.opening_due > 0 ? '− ' : '+ ') + rs(Math.abs(t.opening_due))) : ''}
        ${line('Advance outstanding', rs(bill.advance_balance))}
      </dl>
      ${bill.status === 'closed' ? `
      <div class="rounded-lg bg-sunken p-3 text-sm space-y-1">
        <p class="font-medium">Month closed</p>
        ${st.paid_cash ? `<p>${st.paid_cash > 0 ? 'Paid to supplier' : 'Received from supplier'}: <b>${rs(Math.abs(st.paid_cash))}</b></p>` : ''}
        ${st.advance_cut ? `<p>${st.advance_cut > 0 ? 'Cut from advance' : 'Moved into advance'}: <b>${rs(Math.abs(st.advance_cut))}</b></p>` : ''}
        <p>Carried to next month: <b>${rsSigned(st.carried || 0)}</b></p>
      </div>` : ''}
      ${bill.note ? `<p class="text-xs text-muted whitespace-pre-line">${esc(bill.note)}</p>` : ''}
    </div>`;
  }

  function warnings() {
    if (!bill.warnings.length) return '';
    return `
    <details class="card card-pad no-print" ${bill.warnings.length <= 3 ? 'open' : ''}>
      <summary class="cursor-pointer text-sm font-medium text-warn">⚠ ${bill.warnings.length} thing(s) to check on this bill</summary>
      <ul class="mt-2 text-sm text-muted list-disc pl-5 space-y-0.5">${bill.warnings.map((w) => `<li>${esc(w)}</li>`).join('')}</ul>
    </details>`;
  }

  function editGrid() {
    const locked = bill.status === 'closed' || !can('clerk');
    const [y, m] = bill.month.split('-').map(Number);
    const rows = bill.days.map((d) => {
      const dow = new Date(y, m - 1, d.day).toLocaleDateString('en-GB', { weekday: 'short' });
      const kh = d.kharcha.map((k) => `<span class="chip bg-brand-soft text-brand">${num(k.amount)}${k.tag ? `<sup>${esc(k.tag)}</sup>` : ''}
        ${locked ? '' : `<button data-del-k="${k.id}" class="px-1 rounded hover:bg-brand/20" aria-label="Remove">×</button>`}</span>`).join('');
      return `<tr data-day="${d.day}" class="${d.mismatch !== undefined ? 'bg-warn/5' : ''}">
        <td class="!py-1 whitespace-nowrap"><span class="font-medium tabular-nums">${d.day}</span> <span class="text-xs text-muted">${dow}</span></td>
        <td class="!py-1 !px-1"><input class="cell" data-f="weight" type="number" inputmode="decimal" step="0.001" min="0" value="${d.weight ?? ''}" ${locked ? 'disabled' : ''} aria-label="Weight day ${d.day}" /></td>
        <td class="!py-1 !px-1"><input class="cell" data-f="rate" type="number" inputmode="decimal" step="0.01" min="0" value="${d.rate ?? ''}" ${locked ? 'disabled' : ''} aria-label="Rate day ${d.day}" /></td>
        <td class="!py-1 num font-medium" data-amount>${d.amount != null ? num(d.amount) : '<span class="text-faint">—</span>'}${d.mismatch !== undefined ? `<span class="block text-[11px] text-warn" title="weight × rate">should be ${num(d.mismatch)}</span>` : ''}</td>
        <td class="!py-1"><div class="flex flex-wrap gap-1 items-center">${d.day === 1 && bill.opening_due > 0 ? `<span class="chip bg-sunken text-muted" title="Carried from last month">${num(bill.opening_due)} b/f</span>` : ''}${kh}
          ${locked ? '' : `<input class="cell !w-24 !text-left" data-f="kharcha" type="number" inputmode="numeric" placeholder="+ add" aria-label="Add kharcha day ${d.day}" />`}</div></td>
        <td class="!py-1 !px-1"><input class="cell !text-left" data-f="note" value="${esc(d.note ?? '')}" ${locked ? 'disabled' : ''} placeholder="" aria-label="Note day ${d.day}" /></td>
        <td class="!py-1 w-16 text-right text-xs" data-state></td>
      </tr>`;
    }).join('');
    const t = bill.totals;
    return `
    <div class="card overflow-x-auto">
      <table class="tbl min-w-[720px]">
        <thead><tr><th class="w-20">Day</th><th class="text-right w-28">Weight (kg)</th><th class="text-right w-28">Rate</th><th class="text-right w-28">Amount</th><th>Kharcha</th><th>Note</th><th></th></tr></thead>
        <tbody id="grid">${rows}</tbody>
        <tfoot><tr class="font-semibold bg-sunken/60">
          <td class="px-3 py-2">Total</td><td class="px-3 py-2 num">${kg(t.weight)}</td><td class="px-3 py-2 num text-muted font-normal">${t.avg_rate ? 'avg ' + t.avg_rate : ''}</td>
          <td class="px-3 py-2 num">${num(t.total)}</td><td class="px-3 py-2">${num(t.kharcha)}</td><td colspan="2"></td></tr></tfoot>
      </table>
    </div>
    <p class="text-xs text-muted no-print">Each day saves when you leave it. Enter kharcha and press Enter to add it; several on one day show as 1250+200 on the bill.</p>`;
  }

  function render() {
    const locked = bill.status === 'closed';
    page.innerHTML = `
    <div class="no-print flex flex-wrap items-start gap-3 justify-between">
      <div class="min-w-0">
        <a href="/bills?month=${bill.month}" class="text-sm text-muted hover:text-ink">← ${monthName(bill.month)} bills</a>
        <h1 class="h-title flex items-center gap-2 flex-wrap">
          <a href="/supplier?id=${bill.supplier.id}" class="hover:text-brand">${esc(bill.supplier.name)}</a>
          <span class="chip ${locked ? 'bg-sunken text-muted' : 'bg-good/10 text-good'}">${locked ? 'Closed' : 'Open'}</span>
          ${bill.flower ? `<span class="chip bg-brand-soft text-brand">${esc(bill.flower.name)}</span>` : ''}
        </h1>
        <p class="text-sm text-muted">${monthName(bill.month)} · bill ${nb.position} of ${nb.count}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn-ghost ${nb.prev ? '' : 'pointer-events-none opacity-40'}" href="/bill?id=${nb.prev}&tab=${tab}" aria-label="Previous supplier">←</a>
        <a class="btn-ghost ${nb.next ? '' : 'pointer-events-none opacity-40'}" href="/bill?id=${nb.next}&tab=${tab}" aria-label="Next supplier">→</a>
        <button class="btn-ghost" id="print"><svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M19 8H5a3 3 0 0 0-3 3v6h4v4h12v-4h4v-6a3 3 0 0 0-3-3zm-3 11H8v-5h8zm3-7a1 1 0 1 1 1-1 1 1 0 0 1-1 1zm-1-9H6v4h12z"/></svg>Print / PDF</button>
        ${can('manager') ? (locked
          ? `<button class="btn-ghost" id="reopen">Reopen</button>`
          : `<button class="btn-ghost" id="settings-btn">Bill settings</button><button class="btn-primary" id="close">Close month</button>`) : ''}
      </div>
    </div>

    ${warnings()}

    <div class="no-print flex gap-1 border-b border-line">
      ${(['paper', 'edit'] as const).map((k) => `<button data-tab="${k}" class="px-4 py-2 text-sm font-medium border-b-2 -mb-px ${tab === k ? 'border-brand text-brand' : 'border-transparent text-muted hover:text-ink'}">${k === 'paper' ? 'Paper view' : 'Edit entries'}</button>`).join('')}
    </div>

    <div class="grid lg:grid-cols-[1fr_300px] gap-5 items-start">
      <div class="min-w-0">
        <div class="${tab === 'paper' ? '' : 'hidden print:block'}" id="sheet">${billSheetHtml(bill, settings)}</div>
        <div class="${tab === 'edit' ? '' : 'hidden'} no-print">${editGrid()}</div>
      </div>
      <div class="no-print lg:sticky lg:top-6">${summary()}</div>
    </div>`;
  }

  async function load() {
    [bill, settings, nb] = await Promise.all([api(`/bills/${id}`), api('/settings'), api(`/bills/${id}/neighbours`)]);
    document.title = `${bill.supplier.name} · ${monthName(bill.month)} · PetalBoard`;
    render();
  }

  // ---- editing (event delegation; the grid is re-rendered after each save) ----
  const dirty = new Set<number>();
  function rowVals(tr: HTMLElement) {
    const v = (f: string) => (tr.querySelector<HTMLInputElement>(`[data-f="${f}"]`)?.value ?? '').trim();
    return { weight: v('weight') === '' ? null : Number(v('weight')), rate: v('rate') === '' ? null : Number(v('rate')), note: v('note') || null };
  }

  page.addEventListener('input', (e) => {
    const inp = e.target as HTMLInputElement;
    const tr = inp.closest<HTMLElement>('tr[data-day]');
    if (!tr || !['weight', 'rate', 'note'].includes(inp.dataset.f || '')) return;
    const { weight, rate } = rowVals(tr);
    const a = amountOf(weight, rate);
    tr.querySelector('[data-amount]')!.innerHTML = a != null ? num(a) : '<span class="text-faint">—</span>';
    tr.querySelector('[data-state]')!.innerHTML = '<span class="text-warn">Not saved</span>';
    dirty.add(Number(tr.dataset.day));
  });

  page.addEventListener('focusout', async (e) => {
    const inp = e.target as HTMLInputElement;
    const tr = inp.closest<HTMLElement>('tr[data-day]');
    if (!tr) return;
    const nxt = (e as FocusEvent).relatedTarget as HTMLElement | null;
    if (nxt && tr.contains(nxt)) return;
    const day = Number(tr.dataset.day);
    if (!dirty.has(day)) return;
    const { weight, rate, note } = rowVals(tr);
    if ((weight == null) !== (rate == null)) return; // wait until both are there
    dirty.delete(day);
    tr.querySelector('[data-state]')!.innerHTML = '<span class="text-muted">Saving…</span>';
    try {
      bill = await api(`/bills/${id}/days/${day}`, { method: 'PUT', body: { weight, rate, note } });
      const focusDay = nxt?.closest<HTMLElement>('tr[data-day]')?.dataset.day;
      const focusField = nxt?.dataset.f;
      render();
      if (focusDay && focusField) page.querySelector<HTMLInputElement>(`tr[data-day="${focusDay}"] [data-f="${focusField}"]`)?.focus();
      page.querySelector(`tr[data-day="${day}"] [data-state]`)!.innerHTML = '<span class="text-good">✓</span>';
    } catch (ex: any) {
      tr.querySelector('[data-state]')!.innerHTML = '<span class="text-bad">Error</span>';
      toast(ex.message, 'error');
    }
  });

  page.addEventListener('keydown', async (e) => {
    const inp = e.target as HTMLInputElement;
    const tr = inp.closest<HTMLElement>('tr[data-day]');
    if (!tr || !inp.dataset.f) return;
    if (inp.dataset.f === 'kharcha' && e.key === 'Enter') {
      e.preventDefault();
      const amount = Number(inp.value);
      if (!amount) return;
      const day = Number(tr.dataset.day);
      const tag = (await dialog(`Kharcha ${num(amount)} on day ${day}`, `
        <div><label class="label">Tag (optional, the small letter written beside it, e.g. B)</label><input name="tag" class="input" maxlength="4" /></div>
        <div><label class="label">Note (optional)</label><input name="note" class="input" /></div>`, 'Add'));
      if (!tag) return;
      try {
        bill = await api(`/bills/${id}/kharcha`, { method: 'POST', body: { day, amount, tag: tag.tag || null, note: tag.note || null } });
        render();
        page.querySelector<HTMLInputElement>(`tr[data-day="${day}"] [data-f="kharcha"]`)?.focus();
        toast(`Kharcha ${num(amount)} added`);
      } catch (ex: any) { toast(ex.message, 'error'); }
      return;
    }
    const move = e.key === 'Enter' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0;
    if (!move) return;
    e.preventDefault();
    const day = Number(tr.dataset.day) + move;
    page.querySelector<HTMLInputElement>(`tr[data-day="${day}"] [data-f="${inp.dataset.f}"]`)?.focus();
  });

  page.addEventListener('click', async (e) => {
    const el = e.target as HTMLElement;
    const tabBtn = el.closest<HTMLButtonElement>('[data-tab]');
    if (tabBtn) { tab = tabBtn.dataset.tab as any; setQuery({ tab }); render(); return; }
    const del = el.closest<HTMLButtonElement>('[data-del-k]');
    if (del) {
      await busy(del, async () => { bill = await api(`/kharcha/${del.dataset.delK}`, { method: 'DELETE' }); render(); toast('Kharcha removed'); });
      return;
    }
    const btn = el.closest<HTMLButtonElement>('button');
    if (!btn) return;
    if (btn.id === 'print') window.print();
    if (btn.id === 'reopen') {
      const ok = await dialog('Reopen this bill?', '<p class="text-sm text-muted">The settlement is removed and next month\'s opening balance goes back to zero until you close it again.</p>', 'Reopen');
      if (ok) await busy(btn, async () => { bill = await api(`/bills/${id}/reopen`, { method: 'POST' }); render(); toast('Bill reopened'); });
    }
    if (btn.id === 'settings-btn') {
      const v = await dialog('Bill settings', `
        <div><label class="label">Commission %</label><input name="commission_pct" type="number" step="0.01" min="0" max="100" class="input" value="${bill.commission_pct}" /></div>
        <div><label class="label">Owed from last month (Rs)</label><input name="opening_due" type="number" class="input" value="${bill.opening_due}" />
          <p class="text-xs text-muted mt-1">Positive: the supplier owed the shop (written as day-1 kharcha). Negative: the shop owed the supplier.</p></div>
        <div><label class="label">Note</label><textarea name="note" rows="3" class="input">${esc(bill.note ?? '')}</textarea></div>`);
      if (v) await busy(btn, async () => {
        bill = await api(`/bills/${id}`, { method: 'PATCH', body: { commission_pct: Number(v.commission_pct), opening_due: Number(v.opening_due || 0), note: v.note || null } });
        render(); toast('Saved');
      });
    }
    if (btn.id === 'close') closeDialog(btn);
  });

  async function closeDialog(btn: HTMLButtonElement) {
    const f = bill.totals.final;
    const owes = f >= 0;
    const html = `
      <div class="rounded-lg bg-sunken p-3">
        <p class="text-sm text-muted">Final total for ${monthName(bill.month)}</p>
        <p class="text-2xl font-semibold tabular-nums ${f < 0 ? 'neg' : 'pos'}">${rsSigned(f)}</p>
        <p class="text-sm text-muted">${balanceWords(f)}</p>
      </div>
      <div><label class="label">${owes ? 'Cash paid to supplier now' : 'Cash received from supplier now'} (Rs)</label>
        <input name="cash" type="number" min="0" class="input" value="0" data-calc /></div>
      ${owes ? `<div><label class="label">Cut from the advance (Rs) · advance now ${rs(bill.advance_balance)}</label>
        <input name="cut" type="number" min="0" class="input" value="0" data-calc /></div>` : `
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="toadv" value="1" data-calc /> Move what is left into the supplier's advance</label>`}
      <p class="text-sm">Carried to next month: <b id="carry" class="tabular-nums"></b></p>
      <div><label class="label">Note (optional)</label><input name="note" class="input" /></div>`;
    const p = dialog('Close the month', html, 'Close month');
    const form = document.body.lastElementChild!.querySelector('form') as HTMLFormElement;
    const calc = () => {
      const fd = new FormData(form);
      const cash = Number(fd.get('cash') || 0);
      let carried: number;
      if (owes) carried = f - cash - Number(fd.get('cut') || 0);
      else carried = fd.get('toadv') ? 0 : f + cash;
      form.querySelector('#carry')!.textContent = rsSigned(carried);
    };
    form.addEventListener('input', calc);
    calc();
    const v = await p;
    if (!v) return;
    const cash = Number(v.cash || 0);
    let body: { paid_cash: number; advance_cut: number; note: string | null };
    if (owes) body = { paid_cash: cash, advance_cut: Number(v.cut || 0), note: v.note || null };
    else {
      const left = f + cash; // still negative or zero
      body = { paid_cash: -cash, advance_cut: v.toadv ? left : 0, note: v.note || null };
    }
    await busy(btn, async () => { bill = await api(`/bills/${id}/close`, { method: 'POST', body }); render(); toast('Month closed'); });
  }

  if (!id) page.innerHTML = '<p class="text-bad">No bill chosen. <a class="underline" href="/bills">Go to bills</a></p>';
  else load().catch((e) => (page.innerHTML = `<p class="text-bad">${esc(e.message)}</p>`));
</script>
