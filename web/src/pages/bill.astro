---
import App from '../layouts/App.astro';
---
<App title="Bill" active="bills" wide>
  <div id="page" class="space-y-4">
    <p class="text-muted text-sm">Loading…</p>
  </div>
</App>

<script>
  import { api, can } from '../lib/api';
  import { printBills, adjustPrintPosition, applyPrintCalibration, PRINT_NOTE } from '../lib/blankprint';
  applyPrintCalibration(); // so Ctrl+P also uses the saved print position
  import { billSheetHtml, type Bill, type Settings } from '../lib/billsheet';
  import { balanceWords, esc, kg, monthName, num, rs, rsSigned } from '../lib/format';
  import { busy, dialog, qp, setQuery, toast } from '../lib/ui';

  const id = Number(qp('id'));
  let tab = (qp('tab') as 'paper' | 'edit') || 'paper';
  let bill: Bill;
  let settings: Settings;
  let nb: { prev: number | null; next: number | null; position: number; count: number };
  const page = document.getElementById('page')!;

  const amountOf = (w: number | null, r: number | null) =>
    w == null || r == null ? null : Math.floor((Math.round(w * 1000) * Math.round(r * 100)) / 100000);

  function summary() {
    const t = bill.totals;
    const line = (label: string, value: string, cls = '') =>
      `<div class="flex justify-between gap-3 py-1.5 ${cls}"><dt class="text-muted">${label}</dt><dd class="tabular-nums font-medium">${value}</dd></div>`;
    const st = bill.settlement;
    return `
    <div class="card card-pad space-y-4">
      <div>
        <p class="stat-label">${t.final >= 0 ? 'Final total' : 'Final total'}</p>
        <p class="text-3xl font-semibold tabular-nums ${t.final < 0 ? 'neg' : t.final > 0 ? 'pos' : ''}">${rsSigned(t.final)}</p>
        <p class="text-sm text-muted">${balanceWords(t.final)}</p>
      </div>
      <dl class="text-sm divide-y divide-line">
        ${line('Flowers', `${kg(t.weight)} kg · ${t.days_supplied} days`)}
        ${line('Average rate', t.avg_rate ? `Rs ${t.avg_rate}/kg` : '—')}
        ${line('Total amount', rs(t.total))}
        ${line(`Commission (${bill.commission_pct}%)`, '− ' + rs(t.commission))}
        ${line('Net amount', rs(t.net))}
        ${line('Kharcha', '− ' + rs(t.kharcha))}
        ${t.opening_due ? line(t.opening_due > 0 ? 'Owed from last month' : 'Due from last month', (t.opening_due > 0 ? '− ' : '+ ') + rs(Math.abs(t.opening_due))) : ''}
        ${line('Advance outstanding', `${rs(bill.advance_balance)} <a class="text-xs text-brand font-normal ml-1" href="/supplier?id=${bill.supplier.id}#advance">history</a>`)}
      </dl>
      ${bill.status === 'closed' ? `
      <div class="rounded-lg bg-sunken p-3 text-sm space-y-1">
        <p class="font-medium">Month closed</p>
        ${st.paid_cash ? `<p>${st.paid_cash > 0 ? 'Paid to supplier' : 'Received from supplier'}: <b>${rs(Math.abs(st.paid_cash))}</b></p>` : ''}
        ${st.advance_cut ? `<p>${st.advance_cut > 0 ? 'Cut from advance' : 'Moved into advance'}: <b>${rs(Math.abs(st.advance_cut))}</b></p>` : ''}
        <p>Carried to next month: <b>${rsSigned(st.carried || 0)}</b></p>
      </div>` : ''}
      ${bill.note ? `<p class="text-xs text-muted whitespace-pre-line">${esc(bill.note)}</p>` : ''}
    </div>`;
  }

  function warnings() {
    if (!bill.warnings.length) return '';
    return `
    <details class="card card-pad no-print" ${bill.warnings.length <= 3 ? 'open' : ''}>
      <summary class="cursor-pointer text-sm font-medium text-warn">⚠ ${bill.warnings.length} thing(s) to check on this bill</summary>
      <ul class="mt-2 text-sm text-muted list-disc pl-5 space-y-0.5">${bill.warnings.map((w) => `<li>${esc(w)}</li>`).join('')}</ul>
    </details>`;
  }

  // Kharcha sent to the server but not confirmed yet: shown faded until it is.
  const pendingK = new Map<number, { key: number; amount: number; tag: string | null }[]>();
  let pendingKey = 0;
  type Day = Bill['days'][number];

  function chipsHtml(d: Day, locked: boolean) {
    const chip = (amount: number, tag: string | null, extra = '') =>
      `<span class="chip bg-brand-soft text-brand transition-opacity ${extra}">${num(amount)}${tag ? `<sup>${esc(tag)}</sup>` : ''}`;
    const bf = d.day === 1 && bill.opening_due > 0 ? `<span class="chip bg-sunken text-muted" title="Carried from last month">${num(bill.opening_due)} b/f</span>` : '';
    const kh = d.kharcha.map((k) => `${chip(k.amount, k.tag)}
        ${locked ? '' : `<button data-del-k="${k.id}" class="px-1 rounded hover:bg-brand/20" aria-label="Remove">×</button>`}</span>`).join('');
    const pend = (pendingK.get(d.day) || []).map((k) => chip(k.amount, k.tag, 'opacity-50') + '</span>').join('');
    return bf + kh + pend;
  }

  const amountHtml = (d: Day) =>
    (d.amount != null ? num(d.amount) : '<span class="text-faint">—</span>') +
    (d.mismatch !== undefined ? `<span class="block text-[11px] text-warn" title="weight × rate">should be ${num(d.mismatch)}</span>` : '');

  function footHtml() {
    const t = bill.totals;
    return `<tr class="font-semibold bg-sunken/60">
          <td class="px-3 py-2">Total</td><td class="px-3 py-2 num">${kg(t.weight)}</td><td class="px-3 py-2 num text-muted font-normal">${t.avg_rate ? 'avg ' + t.avg_rate : ''}</td>
          <td class="px-3 py-2 num">${num(t.total)}</td><td class="px-3 py-2">${num(t.kharcha)}</td><td class="wide-only"></td><td></td></tr>`;
  }

  const isLocked = () => bill.status === 'closed' || !can('clerk');

  function editGrid() {
    const locked = isLocked();
    const [y, m] = bill.month.split('-').map(Number);
    const rows = bill.days.map((d) => {
      const dow = new Date(y, m - 1, d.day).toLocaleDateString('en-GB', { weekday: 'short' });
      return `<tr data-day="${d.day}" class="${d.mismatch !== undefined ? 'bg-warn/5' : ''}">
        <td class="!py-1 whitespace-nowrap"><span class="font-medium tabular-nums">${d.day}</span> <span class="text-xs text-muted hidden sm:inline">${dow}</span></td>
        <td class="!py-1 !px-1"><input class="cell" data-f="weight" type="number" inputmode="decimal" step="0.001" min="0" value="${d.weight ?? ''}" ${locked ? 'disabled' : ''} aria-label="Weight day ${d.day}" /></td>
        <td class="!py-1 !px-1"><input class="cell" data-f="rate" type="number" inputmode="decimal" step="0.01" min="0" value="${d.rate ?? ''}" ${locked ? 'disabled' : ''} aria-label="Rate day ${d.day}" /></td>
        <td class="!py-1 num font-medium" data-amount>${amountHtml(d)}</td>
        <td class="!py-1"><div class="flex flex-wrap gap-1 items-center"><span class="contents" data-chips>${chipsHtml(d, locked)}</span>
          ${locked ? '' : `<input class="cell !w-16 sm:!w-24 !text-left" data-f="kharcha" type="text" inputmode="numeric" autocomplete="off" enterkeyhint="done" placeholder="+ add" aria-label="Add kharcha day ${d.day}" />`}</div></td>
        <td class="!py-1 !px-1 wide-only"><input class="cell !text-left" data-f="note" value="${esc(d.note ?? '')}" ${locked ? 'disabled' : ''} placeholder="" aria-label="Note day ${d.day}" /></td>
        <td class="!py-1 w-10 sm:w-16 text-right text-xs" data-state></td>
      </tr>`;
    }).join('');
    return `
    <div class="card overflow-x-auto">
      <table class="tbl md:min-w-[720px]">
        <thead><tr><th class="w-10 sm:w-20">Day</th><th class="text-right sm:w-28">kg</th><th class="text-right sm:w-28">Rate</th><th class="text-right sm:w-28">Amount</th><th>Kharcha</th><th class="wide-only">Note</th><th></th></tr></thead>
        <tbody id="grid">${rows}</tbody>
        <tfoot id="grid-foot">${footHtml()}</tfoot>
      </table>
    </div>
    <p class="text-xs text-muted no-print hidden sm:block">Everything saves on its own as you go. Several kharcha on one day show as 1250+200 on the bill; for the small letter written beside one, type it after the amount (1250B).</p>`;
  }

  /** Show a fresh copy of the bill from the server without redrawing the grid, so boxes still being typed in and the cursor stay put. */
  function applyBill() {
    const set = (sel: string, html: string) => { const el = page.querySelector(sel); if (el) el.innerHTML = html; };
    set('#warn-box', warnings());
    set('#sheet', PRINT_NOTE + billSheetHtml(bill, settings));
    set('#summary-box', summary());
    set('#grid-foot', footHtml());
    const locked = isLocked();
    for (const d of bill.days) {
      const tr = page.querySelector<HTMLElement>(`tr[data-day="${d.day}"]`);
      if (!tr) continue;
      tr.querySelector('[data-chips]')!.innerHTML = chipsHtml(d, locked);
      if (!dirty.has(d.day)) {
        tr.querySelector('[data-amount]')!.innerHTML = amountHtml(d);
        tr.classList.toggle('bg-warn/5', d.mismatch !== undefined);
      }
    }
  }

  function render() {
    const locked = bill.status === 'closed';
    page.innerHTML = `
    <div class="no-print flex flex-wrap items-start gap-3 justify-between">
      <div class="min-w-0">
        <a href="/bills?month=${bill.month}" class="text-sm text-muted hover:text-ink">← ${monthName(bill.month)} bills</a>
        <h1 class="h-title flex items-center gap-2 flex-wrap">
          <a href="/supplier?id=${bill.supplier.id}" class="hover:text-brand">${esc(bill.supplier.name)}</a>
          <span class="chip ${locked ? 'bg-sunken text-muted' : 'bg-good/10 text-good'}">${locked ? 'Closed' : 'Open'}</span>
          ${bill.flower ? `<span class="chip bg-brand-soft text-brand">${esc(bill.flower.name)}</span>` : ''}
        </h1>
        <p class="text-sm text-muted">${monthName(bill.month)} · bill ${nb.position} of ${nb.count}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn-ghost ${nb.prev ? '' : 'pointer-events-none opacity-40'}" href="/bill?id=${nb.prev}&tab=${tab}" aria-label="Previous supplier">←</a>
        <a class="btn-ghost ${nb.next ? '' : 'pointer-events-none opacity-40'}" href="/bill?id=${nb.next}&tab=${tab}" aria-label="Next supplier">→</a>
        <button class="btn-ghost" id="print"><svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M19 8H5a3 3 0 0 0-3 3v6h4v4h12v-4h4v-6a3 3 0 0 0-3-3zm-3 11H8v-5h8zm3-7a1 1 0 1 1 1-1 1 1 0 0 1-1 1zm-1-9H6v4h12z"/></svg>Print</button>
        <button class="btn-ghost" id="print-full" title="Print or save a PDF with the form design">With design / PDF</button>
        <button class="btn-ghost" id="print-adjust" title="Move the printed numbers to fit your blank forms">Print position</button>
        ${can('manager') ? (locked
          ? `<button class="btn-ghost" id="reopen">Reopen</button>`
          : `<button class="btn-ghost" id="settings-btn">Bill settings</button><button class="btn-primary" id="close">Close month</button>`) : ''}
      </div>
    </div>

    <div id="warn-box">${warnings()}</div>

    <div class="no-print flex gap-1 border-b border-line">
      ${(['paper', 'edit'] as const).map((k) => `<button data-tab="${k}" class="px-4 py-2 text-sm font-medium border-b-2 -mb-px ${tab === k ? 'border-brand text-brand' : 'border-transparent text-muted hover:text-ink'}">${k === 'paper' ? 'Paper view' : 'Edit entries'}</button>`).join('')}
    </div>

    <div class="grid lg:grid-cols-[1fr_300px] gap-5 items-start">
      <div class="min-w-0">
        <div class="${tab === 'paper' ? '' : 'hidden print:block'}" id="sheet">${PRINT_NOTE}${billSheetHtml(bill, settings)}</div>
        <div class="${tab === 'edit' ? '' : 'hidden'} no-print" id="edit-pane">${editGrid()}</div>
      </div>
      <div class="no-print lg:sticky lg:top-6" id="summary-box">${summary()}</div>
    </div>`;
  }

  async function load() {
    [bill, settings, nb] = await Promise.all([api(`/bills/${id}`), api('/settings'), api(`/bills/${id}/neighbours`)]);
    document.title = `${bill.supplier.name} · ${monthName(bill.month)} · PetalBoard`;
    render();
  }

  // ---- editing ----
  // Every change saves on its own. After a save the page is updated in place (applyBill), never
  // redrawn, so anything typed elsewhere stays. Saves run one at a time so the newest bill wins.
  const dirty = new Set<number>();
  let queue: Promise<unknown> = Promise.resolve();
  const enqueue = (job: () => Promise<void>) => (queue = queue.then(job, job));

  function rowVals(tr: HTMLElement) {
    const v = (f: string) => (tr.querySelector<HTMLInputElement>(`[data-f="${f}"]`)?.value ?? '').trim();
    return { weight: v('weight') === '' ? null : Number(v('weight')), rate: v('rate') === '' ? null : Number(v('rate')), note: v('note') || null };
  }
  const rowOf = (day: number) => page.querySelector<HTMLElement>(`tr[data-day="${day}"]`);
  const setState = (day: number, html: string) => {
    const cell = rowOf(day)?.querySelector('[data-state]');
    if (cell) cell.innerHTML = html;
  };
  const saving = new Map<number, number>(); // day → saves still running
  function startSave(day: number) {
    saving.set(day, (saving.get(day) || 0) + 1);
    if (!dirty.has(day)) setState(day, '<span class="text-muted">Saving…</span>');
  }
  function endSave(day: number, ok: boolean) {
    const left = Math.max(0, (saving.get(day) || 1) - 1);
    saving.set(day, left);
    if (!ok) return setState(day, '<span class="text-bad">Error</span>');
    if (left || dirty.has(day)) return;
    setState(day, '<span class="text-good">✓</span>');
    setTimeout(() => { if (!dirty.has(day) && !saving.get(day)) setState(day, ''); }, 1500);
  }

  /** "1250", "1250B" or "1250 B" → amount and tag. */
  function parseKharcha(v: string) {
    const m = v.trim().match(/^(-?\d+)\s*([^\d\s]{1,4})?$/);
    return m && Number(m[1]) ? { amount: Number(m[1]), tag: m[2] || null } : null;
  }

  /** Add whatever is typed in a day's kharcha box (shown faded straight away, solid once saved). */
  function addTypedKharcha(tr: HTMLElement) {
    const inp = tr.querySelector<HTMLInputElement>('[data-f="kharcha"]');
    if (!inp || !inp.value.trim()) return;
    const k = parseKharcha(inp.value);
    if (!k) return toast('Kharcha must be an amount, e.g. 1250 or 1250B', 'error');
    const day = Number(tr.dataset.day);
    const key = ++pendingKey;
    inp.value = '';
    pendingK.set(day, [...(pendingK.get(day) || []), { key, ...k }]);
    tr.querySelector('[data-chips]')!.innerHTML = chipsHtml(bill.days.find((d) => d.day === day)!, false);
    startSave(day);
    const unpend = () => pendingK.set(day, (pendingK.get(day) || []).filter((p) => p.key !== key));
    enqueue(async () => {
      try {
        bill = await api(`/bills/${id}/kharcha`, { method: 'POST', body: { day, amount: k.amount, tag: k.tag, note: null } });
        unpend(); applyBill(); endSave(day, true);
      } catch (ex: any) {
        unpend(); applyBill(); endSave(day, false);
        const box = rowOf(day)?.querySelector<HTMLInputElement>('[data-f="kharcha"]');
        if (box && !box.value) box.value = `${k.amount}${k.tag || ''}`; // give it back to retry
        toast(ex.message, 'error');
      }
    });
  }

  /** Save the day's weight, rate and note if they changed and are complete. */
  function saveDay(tr: HTMLElement) {
    const day = Number(tr.dataset.day);
    if (!dirty.has(day)) return;
    const { weight, rate, note } = rowVals(tr);
    if ((weight == null) !== (rate == null)) return; // wait until both are there
    dirty.delete(day);
    startSave(day);
    enqueue(async () => {
      try {
        bill = await api(`/bills/${id}/days/${day}`, { method: 'PUT', body: { weight, rate, note } });
        applyBill(); endSave(day, true);
      } catch (ex: any) {
        dirty.add(day); endSave(day, false);
        toast(ex.message, 'error');
      }
    });
  }

  page.addEventListener('input', (e) => {
    const inp = e.target as HTMLInputElement;
    const tr = inp.closest<HTMLElement>('tr[data-day]');
    if (!tr || !['weight', 'rate', 'note'].includes(inp.dataset.f || '')) return;
    const { weight, rate } = rowVals(tr);
    const a = amountOf(weight, rate);
    tr.querySelector('[data-amount]')!.innerHTML = a != null ? num(a) : '<span class="text-faint">—</span>';
    tr.querySelector('[data-state]')!.innerHTML = '<span class="text-warn">Not saved</span>';
    dirty.add(Number(tr.dataset.day));
  });

  page.addEventListener('focusout', (e) => {
    const inp = e.target as HTMLInputElement;
    const tr = inp.closest<HTMLElement>('tr[data-day]');
    if (!tr) return;
    if (inp.dataset.f === 'kharcha') addTypedKharcha(tr);
    const nxt = (e as FocusEvent).relatedTarget as HTMLElement | null;
    if (nxt && tr.contains(nxt)) return; // still on the same day
    saveDay(tr);
  });

  page.addEventListener('keydown', (e) => {
    const inp = e.target as HTMLInputElement;
    const tr = inp.closest<HTMLElement>('tr[data-day]');
    if (!tr || !inp.dataset.f) return;
    if (inp.dataset.f === 'kharcha' && e.key === 'Enter') {
      e.preventDefault();
      addTypedKharcha(tr); // stay in the box for the next one
      return;
    }
    const move = e.key === 'Enter' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0;
    if (!move) return;
    e.preventDefault();
    const day = Number(tr.dataset.day) + move;
    page.querySelector<HTMLInputElement>(`tr[data-day="${day}"] [data-f="${inp.dataset.f}"]`)?.focus();
  });

  window.addEventListener('beforeunload', (e) => {
    const typed = [...page.querySelectorAll<HTMLInputElement>('[data-f="kharcha"]')].some((i) => i.value.trim());
    if (dirty.size || typed || [...saving.values()].some(Boolean)) e.preventDefault();
  });

  page.addEventListener('click', async (e) => {
    const el = e.target as HTMLElement;
    const tabBtn = el.closest<HTMLButtonElement>('[data-tab]');
    if (tabBtn) {
      // Switch without redrawing, so nothing typed in the grid is lost.
      tab = tabBtn.dataset.tab as any;
      setQuery({ tab });
      page.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => {
        const on = b.dataset.tab === tab;
        b.classList.toggle('border-brand', on); b.classList.toggle('text-brand', on);
        b.classList.toggle('border-transparent', !on); b.classList.toggle('text-muted', !on); b.classList.toggle('hover:text-ink', !on);
      });
      const sheet = page.querySelector('#sheet')!;
      sheet.classList.toggle('hidden', tab !== 'paper');
      sheet.classList.toggle('print:block', tab !== 'paper');
      page.querySelector('#edit-pane')!.classList.toggle('hidden', tab !== 'edit');
      return;
    }
    const del = el.closest<HTMLButtonElement>('[data-del-k]');
    if (del) {
      const day = Number(del.closest<HTMLElement>('tr[data-day]')!.dataset.day);
      del.closest('.chip')?.classList.add('opacity-40');
      del.disabled = true;
      startSave(day);
      enqueue(async () => {
        try { bill = await api(`/kharcha/${del.dataset.delK}`, { method: 'DELETE' }); applyBill(); endSave(day, true); }
        catch (ex: any) { applyBill(); endSave(day, false); toast(ex.message, 'error'); }
      });
      return;
    }
    const btn = el.closest<HTMLButtonElement>('button');
    if (!btn) return;
    if (btn.id === 'print') printBills();
    if (btn.id === 'print-full') printBills(true);
    if (btn.id === 'print-adjust') adjustPrintPosition();
    if (btn.id === 'reopen') {
      const ok = await dialog('Reopen this bill?', '<p class="text-sm text-muted">The settlement is removed and next month\'s opening balance goes back to zero until you close it again.</p>', 'Reopen');
      if (ok) await busy(btn, async () => { bill = await api(`/bills/${id}/reopen`, { method: 'POST' }); render(); toast('Bill reopened'); });
    }
    if (btn.id === 'settings-btn') {
      const v = await dialog('Bill settings', `
        <div><label class="label">Commission %</label><input name="commission_pct" type="number" step="0.01" min="0" max="100" class="input" value="${bill.commission_pct}" /></div>
        <div><label class="label">Owed from last month (Rs)</label><input name="opening_due" type="number" class="input" value="${bill.opening_due}" />
          <p class="text-xs text-muted mt-1">Positive: the supplier owed the shop (written as day-1 kharcha). Negative: the shop owed the supplier.</p></div>
        <div><label class="label">Note</label><textarea name="note" rows="3" class="input">${esc(bill.note ?? '')}</textarea></div>`);
      if (v) await busy(btn, async () => {
        bill = await api(`/bills/${id}`, { method: 'PATCH', body: { commission_pct: Number(v.commission_pct), opening_due: Number(v.opening_due || 0), note: v.note || null } });
        applyBill(); toast('Saved');
      });
    }
    if (btn.id === 'close') closeDialog(btn);
  });

  async function closeDialog(btn: HTMLButtonElement) {
    await queue; // let entries still saving finish, so the final total is up to date
    const f = bill.totals.final;
    const owes = f >= 0;
    const outstanding = bill.advance_balance;
    // The most that can be cut: no more than is outstanding, no more than the bill leaves for the supplier.
    const limit = Math.max(0, Math.min(outstanding, f));
    const why = outstanding <= 0 ? 'this supplier has no advance outstanding'
      : f <= 0 ? 'this bill leaves nothing for the supplier'
      : limit === outstanding ? `only ${rs(outstanding)} is outstanding` : `the bill leaves ${rs(f)} for the supplier`;
    const html = `
      <div class="rounded-lg bg-sunken p-3">
        <p class="text-sm text-muted">Final total for ${monthName(bill.month)}</p>
        <p class="text-2xl font-semibold tabular-nums ${f < 0 ? 'neg' : 'pos'}">${rsSigned(f)}</p>
        <p class="text-sm text-muted">${balanceWords(f)}</p>
      </div>
      <div><label class="label">${owes ? 'Cash paid to supplier now' : 'Cash received from supplier now'} (Rs)</label>
        <input name="cash" type="number" min="0" class="input" value="0" data-calc /></div>
      ${owes ? `<div>
        <label class="label">Cut from the outstanding advance (Rs) · outstanding ${rs(outstanding)}</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 mb-1.5" role="group" aria-label="How much to cut">
          <button type="button" class="btn-ghost !py-1.5 !px-2 text-sm justify-center whitespace-nowrap" data-cut="0">None</button>
          <button type="button" class="btn-ghost !py-1.5 !px-2 text-sm justify-center whitespace-nowrap" data-cut="${Math.floor(limit / 2)}" ${limit ? '' : 'disabled'}>50% · ${num(Math.floor(limit / 2))}</button>
          <button type="button" class="btn-ghost !py-1.5 !px-2 text-sm justify-center whitespace-nowrap" data-cut="${limit}" ${limit ? '' : 'disabled'}>Full · ${num(limit)}</button>
          <button type="button" class="btn-ghost !py-1.5 !px-2 text-sm justify-center whitespace-nowrap" data-cut="custom" ${limit ? '' : 'disabled'}>Custom</button>
        </div>
        <input name="cut" type="number" min="0" max="${limit}" step="1" class="input" value="0" data-calc ${limit ? '' : 'readonly'} />
        <p class="text-xs mt-1 text-muted" id="cut-help">Up to ${rs(limit)}: ${why}.</p>
      </div>` : `
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" name="toadv" value="1" data-calc /> Move what is left into the supplier's advance</label>`}
      <p class="text-sm">Carried to next month: <b id="carry" class="tabular-nums"></b></p>
      <div><label class="label">Note (optional)</label><input name="note" class="input" /></div>`;
    const p = dialog('Close the month', html, 'Close month');
    const form = document.body.lastElementChild!.querySelector('form') as HTMLFormElement;
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const cutBox = form.querySelector<HTMLInputElement>('[name=cut]');
    const calc = () => {
      const fd = new FormData(form);
      const cash = Number(fd.get('cash') || 0);
      const cut = Number(fd.get('cut') || 0);
      let carried: number;
      if (owes) carried = f - cash - cut;
      else carried = fd.get('toadv') ? 0 : f + cash;
      form.querySelector('#carry')!.textContent = rsSigned(carried);
      if (!cutBox) return;
      // Over the limit: say why and do not allow closing.
      const bad = cut > limit || cut < 0 || !Number.isInteger(cut);
      const help = form.querySelector('#cut-help')!;
      help.textContent = cut > limit ? `Too much: no more than ${rs(limit)} can be cut, because ${why}.`
        : cut < 0 || !Number.isInteger(cut) ? 'Type a whole amount in rupees.'
        : `Up to ${rs(limit)}: ${why}.`;
      help.classList.toggle('text-bad', bad);
      help.classList.toggle('text-muted', !bad);
      cutBox.classList.toggle('!border-bad', bad);
      submit.disabled = bad;
      const mode = form.dataset.mode || '';
      form.querySelectorAll<HTMLButtonElement>('[data-cut]').forEach((b) => {
        const on = b.dataset.cut === 'custom' ? mode === 'custom' : mode !== 'custom' && Number(b.dataset.cut) === cut;
        b.classList.toggle('bg-brand-soft', on);
        b.classList.toggle('text-brand', on);
      });
    };
    form.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cut]');
      if (!b || !cutBox) return;
      const custom = b.dataset.cut === 'custom';
      form.dataset.mode = custom ? 'custom' : '';
      if (!custom) cutBox.value = b.dataset.cut!;
      else { cutBox.focus(); cutBox.select(); }
      calc();
    });
    cutBox?.addEventListener('input', () => { form.dataset.mode = 'custom'; });
    form.addEventListener('input', calc);
    calc();
    const v = await p;
    if (!v) return;
    const cash = Number(v.cash || 0);
    let body: { paid_cash: number; advance_cut: number; note: string | null };
    if (owes) body = { paid_cash: cash, advance_cut: Number(v.cut || 0), note: v.note || null };
    else {
      const left = f + cash; // still negative or zero
      body = { paid_cash: -cash, advance_cut: v.toadv ? left : 0, note: v.note || null };
    }
    await busy(btn, async () => { bill = await api(`/bills/${id}/close`, { method: 'POST', body }); render(); toast('Month closed'); });
    // The cut paid the advance off: offer (never force) to close the khaata.
    if (bill.status === 'closed' && body.advance_cut > 0 && bill.advance_balance === 0 && can('manager')) {
      const [y, m] = bill.month.split('-').map(Number);
      const monthEnd = `${bill.month}-${String(new Date(y, m, 0).getDate()).padStart(2, '0')}`;
      const k = await dialog('Outstanding is now 0', `
        <p class="text-sm">${esc(bill.supplier.name)} has paid back the whole advance. Do you want to close this khaata?</p>
        <p class="text-sm text-muted">Only if the khaata is really finished. You can renew it later on new terms.</p>
        <div><label class="label">Reason (optional)</label><input name="reason" class="input" /></div>`, 'Close khaata');
      if (k) {
        try {
          await api(`/suppliers/${bill.supplier.id}/khaata/close`, { method: 'POST', body: { on_date: monthEnd, reason: k.reason || null } });
          toast('Khaata closed');
        } catch (ex: any) { toast(ex.message, 'error'); }
      }
    }
  }


  if (!id) page.innerHTML = '<p class="text-bad">No bill chosen. <a class="underline" href="/bills">Go to bills</a></p>';
  else load().catch((e) => (page.innerHTML = `<p class="text-bad">${esc(e.message)}</p>`));
</script>
