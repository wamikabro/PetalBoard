---
// The app shell: navigation, login check, theme toggle and the toast area.
import '../styles/global.css';
import '../styles/billsheet.css';

interface Props {
  title: string;
  active?: string;
  bare?: boolean; // login page: no navigation, no login check
  wide?: boolean;
}
const { title, active = '', bare = false, wide = false } = Astro.props;

const nav = [
  { href: '/', key: 'dashboard', label: 'Dashboard', icon: 'M3 13h8V3H3zm0 8h8v-6H3zm10 0h8V11h-8zm0-18v6h8V3z' },
  { href: '/daily', key: 'daily', label: 'Daily entry', icon: 'M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V9h14zM7 11h5v5H7z' },
  { href: '/bills', key: 'bills', label: 'Bills', icon: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zm2 16H8v-2h8zm0-4H8v-2h8zm-3-5V3.5L18.5 9z' },
  { href: '/suppliers', key: 'suppliers', label: 'Suppliers', icon: 'M16 11a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm-8 0a3 3 0 1 0-3-3 3 3 0 0 0 3 3zm0 2c-2.3 0-7 1.2-7 3.5V19h14v-2.5C15 14.2 10.3 13 8 13zm8 0h-1a4.2 4.2 0 0 1 2 3.5V19h6v-2.5c0-2.3-4.7-3.5-7-3.5z' },
  { href: '/investors', key: 'investors', label: 'Investors', icon: 'M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z' },
  { href: '/reports', key: 'reports', label: 'Reports', icon: 'M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z' },
  { href: '/settings', key: 'settings', label: 'Settings', icon: 'M19.4 13a7.6 7.6 0 0 0 0-2l2.1-1.6-2-3.5-2.5 1a7.3 7.3 0 0 0-1.7-1L15 3h-4l-.4 2.7a7.3 7.3 0 0 0-1.7 1l-2.5-1-2 3.5L6.6 11a7.6 7.6 0 0 0 0 2l-2.1 1.6 2 3.5 2.5-1a7.3 7.3 0 0 0 1.7 1L11 21h4l.4-2.7a7.3 7.3 0 0 0 1.7-1l2.5 1 2-3.5zM13 15.5a3.5 3.5 0 1 1 3.5-3.5 3.5 3.5 0 0 1-3.5 3.5z' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · PetalBoard</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Kalam:wght@400&family=Noto+Nastaliq+Urdu:wght@400;700&display=swap" rel="stylesheet" />
    <script is:inline>
      try { const t = localStorage.getItem('petalboard_theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
    {!bare && (
      <script is:inline>
        try { if (!localStorage.getItem('petalboard_token')) location.replace('/login?next=' + encodeURIComponent(location.pathname + location.search)); } catch {}
      </script>
    )}
  </head>
  <body class="min-h-screen">
    {bare ? (
      <slot />
    ) : (
      <div class="lg:flex min-h-screen">
        <aside class="no-print hidden lg:flex lg:flex-col w-60 shrink-0 border-r border-line bg-panel sticky top-0 h-screen">
          <a href="/" class="flex items-center gap-2.5 px-5 h-16 border-b border-line">
            <img src="/favicon.svg" alt="" class="w-8 h-8" />
            <span class="font-semibold tracking-tight text-lg">PetalBoard</span>
          </a>
          <nav class="flex-1 p-3 space-y-0.5">
            {nav.map((n) => (
              <a href={n.href} class={`flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition ${active === n.key ? 'bg-brand-soft text-brand' : 'text-muted hover:bg-sunken hover:text-ink'}`} aria-current={active === n.key ? 'page' : undefined}>
                <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current" aria-hidden="true"><path d={n.icon} /></svg>
                {n.label}
              </a>
            ))}
          </nav>
          <div class="p-3 border-t border-line">
            <div class="flex items-center gap-2 px-2">
              <div class="w-8 h-8 rounded-full bg-brand-soft text-brand grid place-items-center text-sm font-semibold" data-user-initial>·</div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium truncate" data-user-name></p>
                <p class="text-xs text-muted capitalize" data-user-role></p>
              </div>
              <button class="btn-ghost !px-2 !py-1.5" data-theme-toggle title="Light / dark" aria-label="Switch light or dark">
                <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" /></svg>
              </button>
            </div>
            <button class="mt-2 w-full text-left text-xs text-muted hover:text-ink px-2" data-logout>Log out</button>
          </div>
        </aside>

        <div class="flex-1 min-w-0 pb-20 lg:pb-0">
          <header class="no-print lg:hidden sticky top-0 z-30 bg-panel/90 backdrop-blur border-b border-line h-14 flex items-center justify-between px-4">
            <a href="/" class="flex items-center gap-2"><img src="/favicon.svg" alt="" class="w-7 h-7" /><span class="font-semibold">PetalBoard</span></a>
            <div class="flex items-center gap-1">
              <button class="btn-ghost !px-2 !py-1.5" data-theme-toggle aria-label="Switch light or dark">
                <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z" /></svg>
              </button>
              <a href="/reports" class="btn-ghost !px-2 !py-1.5" aria-label="Reports">
                <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d={nav[5].icon} /></svg>
              </a>
              <a href="/settings" class="btn-ghost !px-2 !py-1.5" aria-label="Settings">
                <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current"><path d={nav[6].icon} /></svg>
              </a>
            </div>
          </header>
          <main class={`mx-auto px-4 sm:px-6 py-5 sm:py-8 ${wide ? 'max-w-[1400px]' : 'max-w-6xl'}`}>
            <slot />
          </main>
        </div>

        <nav class="no-print lg:hidden fixed bottom-0 inset-x-0 z-30 bg-panel border-t border-line grid grid-cols-5 pb-[env(safe-area-inset-bottom)]">
          {nav.slice(0, 5).map((n) => (
            <a href={n.href} class={`flex flex-col items-center gap-0.5 py-2 text-[11px] font-medium ${active === n.key ? 'text-brand' : 'text-muted'}`}>
              <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current" aria-hidden="true"><path d={n.icon} /></svg>
              {n.label.replace(' entry', '')}
            </a>
          ))}
        </nav>
      </div>
    )}
    <div id="toasts" class="no-print fixed z-[60] bottom-24 lg:bottom-6 right-4 left-4 sm:left-auto flex flex-col items-end gap-2 pointer-events-none" aria-live="polite"></div>
    <script>
      import { api, clearLogin, getUser } from '../lib/api';
      const u = getUser();
      document.querySelectorAll('[data-user-name]').forEach((e) => (e.textContent = u?.display_name || ''));
      document.querySelectorAll('[data-user-role]').forEach((e) => (e.textContent = u?.role || ''));
      document.querySelectorAll('[data-user-initial]').forEach((e) => (e.textContent = (u?.display_name || '·')[0]));
      document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
        b.addEventListener('click', () => {
          const dark = document.documentElement.dataset.theme
            ? document.documentElement.dataset.theme === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          const next = dark ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('petalboard_theme', next); } catch {}
          window.dispatchEvent(new Event('themechange'));
        }),
      );
      document.querySelectorAll('[data-logout]').forEach((b) =>
        b.addEventListener('click', async () => {
          try { await api('/auth/logout', { method: 'POST' }); } catch {}
          clearLogin();
          location.href = '/login';
        }),
      );
    </script>
  </body>
</html>
